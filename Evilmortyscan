local function getMovementState(character)
if not character or not character.Parent then return "UNKNOWN" end
local hum = character:FindFirstChildOfClass("Humanoid")
local root = character:FindFirstChild("HumanoidRootPart")
if not hum or not root then return "UNKNOWN" end

local s = hum:GetState()  
if s == Enum.HumanoidStateType.Jumping then return "JUMPING"  
elseif s == Enum.HumanoidStateType.Freefall then return "FALLING"  
elseif s == Enum.HumanoidStateType.Climbing then return "CLIMBING"  
elseif s == Enum.HumanoidStateType.Swimming then return "SWIMMING"  
elseif s == Enum.HumanoidStateType.Seated then return "IDLE" end  

local vel = root.AssemblyLinearVelocity  
local horizSpeed = Vector3.new(vel.X, 0, vel.Z).Magnitude  
local vertSpeed = vel.Y  

if vertSpeed < -20 then return "FALLING"  
elseif vertSpeed > 15 then return "JUMPING" end  

if horizSpeed < 1 then return "IDLE"  
elseif horizSpeed < hum.WalkSpeed + 1 then return "WALKING"  
else return "RUNNING" end

end

local function getWeaponName(character)
if not character then return "UNKNOWN" end
local tool = character:FindFirstChildOfClass("Tool")
if not tool then return "UNKNOWN" end
if #tool.Name > CONFIG.WEAPON_NAME_LIMIT then return "NO SE PUEDE ESCANEAR" end
return tool.Name
end

-- Devuelve lista completa de herramientas (equipadas + backpack), sin limite
local function getInventoryList(character, player)
local items = {}
local seen = {}
if not character then return items end

for _, o in ipairs(character:GetChildren()) do  
    if o:IsA("Tool") and not seen[o.Name] then  
        seen[o.Name] = true  
        table.insert(items, o.Name)  
    end  
end  

if player then  
    local backpack = player:FindFirstChildOfClass("Backpack")  
    if backpack then  
        for _, o in ipairs(backpack:GetChildren()) do  
            if o:IsA("Tool") and not seen[o.Name] then  
                seen[o.Name] = true  
                table.insert(items, o.Name)  
            end  
        end  
    end  
end  

return items

end

local function getDistance()
local myChar = LocalPlayer.Character
local tgtChar = state.target and state.target.Character
if not myChar or not tgtChar then return nil end
local a = myChar:FindFirstChild("HumanoidRootPart")
local b = tgtChar:FindFirstChild("HumanoidRootPart")
if not a or not b then return nil end
return math.floor((a.Position - b.Position).Magnitude)
end

local function findClosestPlayer()
local myChar = LocalPlayer.Character
if not myChar then return nil end
local myRoot = myChar:FindFirstChild("HumanoidRootPart")
if not myRoot then return nil end

local closest, minDist = nil, math.huge  
for _, plr in ipairs(Players:GetPlayers()) do  
    if plr ~= LocalPlayer then  
        local char = plr.Character  
        if char then  
            local root = char:FindFirstChild("HumanoidRootPart")  
            local hum = char:FindFirstChildOfClass("Humanoid")  
            if root and hum and hum.Health > 0 then  
                local d = (root.Position - myRoot.Position).Magnitude  
                if d < minDist then minDist = d; closest = plr end  
            end  
        end  
    end  
end  
return closest

end

