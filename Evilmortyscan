-- ============================================================
-- ACTUALIZAR INVENTARIO (lista completa, sin limite)
-- ============================================================
local function refreshInventory(character, player)
local container = state.inventoryContainer
if not container then return end

local items = getInventoryList(character, player)  

-- Si no hay items, mostrar "VACIO"  
if #items == 0 then  
    if #state.inventoryRows == 0 then  
        local l = Instance.new("TextLabel")  
        l.Size = UDim2.new(1, 0, 0, 12)  
        l.BackgroundTransparency = 1  
        l.Text = "  - VACIO"  
        l.TextColor3 = CONFIG.COLORS.YELLOW  
        l.Font = Enum.Font.Code  
        l.TextSize = 10  
        l.TextXAlignment = Enum.TextXAlignment.Left  
        l.TextWrapped = true  
        l.Parent = container  
        table.insert(state.inventoryRows, l)  
    else  
        state.inventoryRows[1].Text = "  - VACIO"  
        for i = #state.inventoryRows, 2, -1 do  
            state.inventoryRows[i]:Destroy()  
            state.inventoryRows[i] = nil  
        end  
    end  
    return  
end  

-- Reutilizar filas existentes  
for i = 1, #items do  
    local rowObj = state.inventoryRows[i]  
    if not rowObj then  
        rowObj = Instance.new("TextLabel")  
        rowObj.Size = UDim2.new(1, 0, 0, 12)  
        rowObj.BackgroundTransparency = 1  
        rowObj.TextColor3 = CONFIG.COLORS.YELLOW  
        rowObj.Font = Enum.Font.Code  
        rowObj.TextSize = 10  
        rowObj.TextXAlignment = Enum.TextXAlignment.Left  
        rowObj.TextWrapped = true  
        rowObj.LayoutOrder = i  
        rowObj.Parent = container  
        state.inventoryRows[i] = rowObj  
    end  
    rowObj.Text = "  - " .. items[i]  
end  

-- Eliminar filas sobrantes  
for i = #state.inventoryRows, #items + 1, -1 do  
    state.inventoryRows[i]:Destroy()  
    state.inventoryRows[i] = nil  
end

end

-- ============================================================
-- ACTUALIZAR DATOS
-- ============================================================
local function refreshData()
if not state.target or not state.billboard then return end
local char = state.target.Character
local L = state.dataLabels

if not char or not char.Parent then  
    L.subject.Text   = "SUJETO: TARGET LOST"  
    L.health.Text    = "SALUD: --"  
    L.weapon.Text    = "ARMA: --"  
    L.movement.Text  = "MOVIMIENTO: --"  
    L.distance.Text  = "DISTANCIA: --"  
    if state.statusLabel then state.statusLabel.Text = "STATUS: LOST" end  
    refreshInventory(nil, nil)  
    return  
end  

local hum = char:FindFirstChildOfClass("Humanoid")  
local moveState = getMovementState(char)  

L.subject.Text = "SUJETO: " .. state.target.Name  
if hum then  
    L.health.Text = string.format("SALUD: %d / %d",  
        math.floor(hum.Health), math.floor(hum.MaxHealth))  
else  
    L.health.Text = "SALUD: UNKNOWN"  
end  
L.weapon.Text   = "ARMA: " .. getWeaponName(char)  
L.movement.Text = "MOVIMIENTO: " .. moveState  
local d = getDistance()  
L.distance.Text = d and ("DISTANCIA: " .. d .. " studs") or "DISTANCIA: UNKNOWN"  

if state.statusLabel then  
    state.statusLabel.Text = "STATUS: " .. moveState  
end  

-- Inventario completo (equipado + Backpack)  
refreshInventory(char, state.target)

end

-- ============================================================
-- ACTUALIZAR LASER
-- ============================================================
local function updateLaser()
if not state.active or not state.target then
laser.Visible = false
return
end
local char = state.target.Character
if not char then laser.Visible = false; return end
local head = char:FindFirstChild("Head")
if not head then laser.Visible = false; return end

local originScreen = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)  
local targetScreen, onScreen = Camera:WorldToViewportPoint(head.Position)  
if not onScreen then laser.Visible = false; return end  

local targetVec = Vector2.new(targetScreen.X, targetScreen.Y)  
local delta = targetVec - originScreen  
local length = delta.Magnitude  
local angle = math.deg(math.atan2(delta.Y, delta.X))  

laser.Visible = true  
laser.Size = UDim2.new(0, length, 0, 1)  
laser.Position = UDim2.new(0, originScreen.X, 0, originScreen.Y)  
laser.Rotation = angle

end

-- ============================================================
-- INICIAR ESCANEO
-- ============================================================
local function startScan()
if state.billboard then state.billboard:Destroy(); state.billboard = nil end
state.inventoryRows = {}

local target = findClosestPlayer()  
if not target then return end  
local char = target.Character  
if not char then return end  
local head = char:FindFirstChild("Head")  
if not head then return end  

state.target = target  
state.active = true  

createBillboard(head, target.Name)  
updateLaser()  
refreshData()

end

-- ============================================================
-- DETENER ESCANEO
-- ============================================================
local function stopScan()
state.active = false
state.target = nil
if state.billboard then state.billboard:Destroy(); state.billboard = nil end
state.inventoryRows = {}
laser.Visible = false
end

-- ============================================================
-- BUCLE EN VIVO
-- ============================================================
if state.updateConn then state.updateConn:Disconnect() end
state.updateConn = RunService.RenderStepped:Connect(function()
if not state.active or not state.target then return end

local char = state.target.Character  
if not char then  
    if state.billboard then state.billboard.Enabled = false end  
    laser.Visible = false  
    return  
end  
local head = char:FindFirstChild("Head")  
if not head then return end  

if not state.billboard or state.billboard.Adornee ~= head then  
    if state.billboard then state.billboard:Destroy() end  
    state.inventoryRows = {}  
    createBillboard(head, state.target.Name)  
end  

state.billboard.Enabled = true  
updateLaser()  
refreshData()

end)
