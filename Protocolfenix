-- Actualiza los textos
task.spawn(function()
	while gui.Parent do
		if mensaje and os.clock() < mensajeHasta then
			boton.Text = mensaje
		else
			mensaje = nil
			boton.Text = "CÁPSULA\n" .. #cola .. "/" .. MAX_CAPSULAS
		end

