local function PurpleExplosion(position)

	local effect = Instance.new("Part")

	effect.Name = "PurpleExplosionEffect"
	effect.Anchored = true
	effect.CanCollide = false
	effect.CanQuery = false
	effect.CanTouch = false
	effect.Transparency = 1
	effect.Size = Vector3.new(1, 1, 1)
	effect.Position = position
	effect.Parent = workspace

	local sound = Instance.new("Sound")
	sound.SoundId = EXPLOSION_SOUND
	sound.Volume = 3.5
	sound.RollOffMaxDistance = 250
	sound.Parent = effect
	sound:Play()

	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(180, 50, 255)
	light.Brightness = 15
	light.Range = 45
	light.Parent = effect

	local attachment = Instance.new("Attachment")
	attachment.Parent = effect

	local particles = Instance.new("ParticleEmitter")

	particles.Texture =
		"rbxasset://textures/particles/sparkles_main.dds"

	particles.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(
			0,
			Color3.fromRGB(220, 80, 255)
		),
		ColorSequenceKeypoint.new(
			0.4,
			Color3.fromRGB(160, 20, 255)
		),
		ColorSequenceKeypoint.new(
			1,
			Color3.fromRGB(60, 0, 120)
		)
	})

	particles.LightEmission = 1
	particles.Lifetime =
		NumberRange.new(0.6, 1.4)

	particles.Speed =
		NumberRange.new(25, 60)

	particles.Rate = 0
	particles.SpreadAngle =
		Vector2.new(360, 360)

	particles.Size =
		NumberSequence.new({
			NumberSequenceKeypoint.new(0, 5),
			NumberSequenceKeypoint.new(0.3, 11),
			NumberSequenceKeypoint.new(1, 0)
		})

	particles.Parent = attachment
	particles:Emit(100)

	task.spawn(function()

		for brightness = 15, 0, -2 do

			if light.Parent then
				light.Brightness = brightness
			end

			task.wait(0.05)
		end
	end)

	Debris:AddItem(effect, 3)
end

--------------------------------------------------
-- EXPLOTAR BOMBA
--------------------------------------------------

local function ExplodeBomb(bomb, velocity)

	if not bomb or not bomb.Parent then
		return
	end

	if velocity and velocity.Parent then
		velocity:Destroy()
	end

	local position = bomb.Position

	local explosion = Instance.new("Explosion")

	explosion.Position = position
	explosion.BlastRadius = 22
	explosion.BlastPressure = 35000
	explosion.DestroyJointRadiusPercent = 0
	explosion.Parent = workspace

	PurpleExplosion(position)

	bomb:Destroy()
end

--------------------------------------------------
-- DISPARAR PORTAL BOMB
--------------------------------------------------

local function FirePortalBomb()

	if not aiming
		or not marker
		or not targetPosition then
		return
	end

	local groundTarget = targetPosition

	local skyPosition =
		groundTarget + Vector3.new(0, 50, 0)

	DestroyMarker()

	targetPosition = nil
	aiming = false
	ready = false

	local portal =
		CreatePortal(skyPosition)

	task.wait(PORTAL_TIME)

	if not portal.Parent then
		ready = true
		return
	end

	local bomb = Instance.new("Part")

	bomb.Name = "Bomb"
	bomb.Shape = Enum.PartType.Ball
	bomb.Size = Vector3.new(2, 2, 2)
	bomb.Material = Enum.Material.SmoothPlastic
	bomb.Color = Color3.fromRGB(10, 10, 10)
	bomb.CanCollide = true
	bomb.Position = portal.Position
	bomb.Parent = workspace

	portal:Destroy()

	local direction =
		groundTarget - bomb.Position

	if direction.Magnitude > 0 then

		local velocity =
			Instance.new("BodyVelocity")

		velocity.MaxForce =
			Vector3.new(
				math.huge,
				math.huge,
				math.huge
			)

		velocity.Velocity =
			direction.Unit * BOMB_SPEED

		velocity.Parent = bomb

		local exploded = false

		bomb.Touched:Connect(function(hit)

			if exploded then
				return
			end

			if hit:IsDescendantOf(Character) then
				return
			end

			if hit.Name == "Portal3D"
				or hit.Name == "TargetMarker" then
				return
			end

			exploded = true

			task.delay(1.5, function()
				ExplodeBomb(bomb, velocity)
			end)
		end)

		task.delay(7, function()

			if bomb.Parent and not exploded then

				exploded = true

				ExplodeBomb(
					bomb,
					velocity
				)
			end
		end)
	else
		bomb:Destroy()
	end

	task.delay(PORTAL_COOLDOWN, function()
		ready = true
	end)
end

--------------------------------------------------
-- APUNTADO
--------------------------------------------------

local function StartAim()

	if not ready or aiming then
		return
	end

	aiming = true
	targetPosition = nil

	if touchAiming then
		return
	end

	targetPosition =
		GetRaycast(
			UserInputService:GetMouseLocation()
		)

	if targetPosition then
		marker =
			CreateMarker(
				targetPosition
				+ Vector3.new(0, 0.2, 0)
			)
	end
end

--------------------------------------------------
-- TOQUE EN CELULAR
--------------------------------------------------

UserInputService.TouchTapInWorld:Connect(
	function(position, processed)

		if processed
			or not aiming
			or not touchAiming then
			return
		end

		local hit =
			GetRaycast(position)

		if not hit then
			return
		end

		targetPosition = hit

		if marker then
			marker.Position =
				hit + Vector3.new(0, 0.2, 0)
		else
			marker =
				CreateMarker(
					hit + Vector3.new(0, 0.2, 0)
				)
		end
	end
)

--------------------------------------------------
-- RATÓN / MARCADOR
--------------------------------------------------

RunService.RenderStepped:Connect(function()

	if not aiming or touchAiming then
		return
	end

	local position =
		GetRaycast(
			UserInputService:GetMouseLocation()
		)

	if position then

		targetPosition = position

		if marker then
			marker.Position =
				position
				+ Vector3.new(0, 0.2, 0)
		end
	end
end)

--------------------------------------------------
-- CONTROLES
--------------------------------------------------

UserInputService.InputBegan:Connect(
	function(input, processed)

		if processed then
			return
		end

		if input.KeyCode == Enum.KeyCode.E then
			StartAim()

		elseif input.UserInputType ==
			Enum.UserInputType.MouseButton1 then

			if aiming and not touchAiming then
				FirePortalBomb()
			end

		elseif input.KeyCode == Enum.KeyCode.Q
			and aiming then

			DestroyMarker()

			targetPosition = nil
			aiming = false
			ready = true
		end
	end
)

