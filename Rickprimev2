local function LoadGunAsset()

	local ok, model = pcall(function()

		local asset =
			InsertService:LoadAsset(PLASMA_ASSET)

		return asset and asset:GetChildren()[1]
	end)

	if ok and model then
		return model
	end

	ok, model = pcall(function()

		local objects =
			game:GetObjects(
				"rbxassetid://" .. PLASMA_ASSET
			)

		return objects and objects[1]
	end)

	if ok and model then
		return model
	end

	return nil
end

--------------------------------------------------
-- CREAR PISTOLA
--------------------------------------------------

local function CreatePlasmaPistol()

	for _, item in ipairs(Player.Backpack:GetChildren()) do
		if item.Name == "Plasma Pistol" then
			item:Destroy()
		end
	end

	local oldGun =
		Character:FindFirstChild("Plasma Pistol")

	if oldGun then
		oldGun:Destroy()
	end

	local gunAsset = LoadGunAsset()

	if not gunAsset then
		warn("No se pudo cargar el asset de la pistola.")
		return
	end

	local tool = Instance.new("Tool")
	tool.Name = "Plasma Pistol"
	tool.RequiresHandle = true
	tool.CanBeDropped = false
	tool.Grip = CFrame.new(0, 0.1, -0.2)

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.2, 0.2, 0.2)
	handle.Transparency = 1
	handle.CanCollide = false
	handle.Massless = true
	handle.Parent = tool

	local rotation =
		CFrame.Angles(
			math.rad(-90),
			math.rad(180),
			0
		)

	if gunAsset:IsA("Model") then

		local primary =
			gunAsset.PrimaryPart
			or gunAsset:FindFirstChildWhichIsA(
				"BasePart",
				true
			)

		if primary then
			gunAsset.PrimaryPart = primary
			gunAsset:PivotTo(
				handle.CFrame * rotation
			)
		end

		for _, part in ipairs(
			gunAsset:GetDescendants()
		) do

			if part:IsA("BasePart") then

				part.CanCollide = false
				part.Anchored = false
				part.Massless = true

				local weld =
					Instance.new("WeldConstraint")

				weld.Part0 = handle
				weld.Part1 = part
				weld.Parent = part
			end
		end

		gunAsset.Parent = tool

	elseif gunAsset:IsA("BasePart") then

		gunAsset.CanCollide = false
		gunAsset.Anchored = false
		gunAsset.Massless = true
		gunAsset.CFrame =
			handle.CFrame * rotation

		local weld =
			Instance.new("WeldConstraint")

		weld.Part0 = handle
		weld.Part1 = gunAsset
		weld.Parent = gunAsset

		gunAsset.Parent = tool
	end

	tool.Equipped:Connect(function()
		ToolEquipped = true
		PlasmaGun = tool
	end)

	tool.Unequipped:Connect(function()
		ToolEquipped = false
		PlasmaGun = nil
	end)

	tool.Activated:Connect(ShootPlasma)

	tool.Parent = Player.Backpack

	print("Plasma Pistol lista")
end

