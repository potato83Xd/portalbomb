local function CreateMarker(position)
	local part = Instance.new("Part")
	part.Name = "TargetMarker"
	part.Size = Vector3.new(4, 0.2, 4)
	part.Material = Enum.Material.Neon
	part.Color = Color3.fromRGB(0, 170, 255)
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Position = position
	part.Parent = workspace

	return part
end

local function DestroyMarker()
	if marker then
		marker:Destroy()
		marker = nil
	end
end

--------------------------------------------------
-- PLASMA
--------------------------------------------------

local function CreatePlasmaBullet(startPos, direction)

	local bullet = Instance.new("Part")
	bullet.Name = "PlasmaBullet"
	bullet.Shape = Enum.PartType.Ball
	bullet.Size = Vector3.new(0.8, 0.8, 0.8)
	bullet.Color = PlasmaRed
	bullet.Material = Enum.Material.Neon
	bullet.CanCollide = false
	bullet.Anchored = true
	bullet.CFrame = CFrame.new(startPos)
	bullet.Parent = workspace

	local light = Instance.new("PointLight")
	light.Color = PlasmaRed
	light.Brightness = 5
	light.Range = 10
	light.Parent = bullet

	local att0 = Instance.new("Attachment")
	att0.Parent = bullet

	local att1 = Instance.new("Attachment")
	att1.Position = Vector3.new(0, 0, 0.4)
	att1.Parent = bullet

	local trail = Instance.new("Trail")
	trail.Attachment0 = att0
	trail.Attachment1 = att1
	trail.Color = ColorSequence.new(
		PlasmaRed,
		PlasmaNeon
	)
	trail.Transparency = NumberSequence.new(0, 1)
	trail.WidthScale = NumberSequence.new(0.5, 0)
	trail.Lifetime = 0.2
	trail.FaceCamera = true
	trail.Parent = bullet

	local sound = Instance.new("Sound")
	sound.SoundId = "rbxassetid://9113083516"
	sound.Volume = 0.5
	sound.Parent = bullet
	sound:Play()

	local travelled = 0
	local connection

	connection = RunService.Heartbeat:Connect(function(dt)

		if not bullet.Parent then
			connection:Disconnect()
			return
		end

		local move = direction * PLASMA_SPEED * dt

		local result = workspace:Raycast(
			bullet.Position,
			move,
			RayParams
		)

		if result or travelled >= PLASMA_DISTANCE then

			connection:Disconnect()

			if result then

				for i = 1, 6 do

					local spark = Instance.new("Part")
					spark.Shape = Enum.PartType.Ball
					spark.Size = Vector3.new(0.2, 0.2, 0.2)
					spark.Color = PlasmaRed
					spark.Material = Enum.Material.Neon
					spark.Anchored = false
					spark.CanCollide = false
					spark.Position = result.Position
					spark.Parent = workspace

					local velocity = Instance.new("BodyVelocity")
					velocity.MaxForce =
						Vector3.new(1e5, 1e5, 1e5)

					velocity.Velocity = Vector3.new(
						math.random(-40, 40),
						math.random(-40, 40),
						math.random(-40, 40)
					)

					velocity.Parent = spark

					Debris:AddItem(spark, 0.4)
					Debris:AddItem(velocity, 0.1)
				end
			end

			bullet:Destroy()
			return
		end

		bullet.CFrame += move
		travelled += move.Magnitude
	end)

	Debris:AddItem(bullet, 3)
end

--------------------------------------------------
-- DISPARAR PLASMA
--------------------------------------------------

local function ShootPlasma()

	if not ToolEquipped
		or not CanShoot
		or not PlasmaGun then
		return
	end

	local handle = PlasmaGun:FindFirstChild("Handle")

	if not handle then
		return
	end

	CanShoot = false

	local mouse = Player:GetMouse()
	local camera = workspace.CurrentCamera

	local startPos =
		handle.Position
		+ camera.CFrame.LookVector * 2

	local direction =
		(mouse.Hit.Position - startPos).Unit

	CreatePlasmaBullet(
		startPos,
		direction
	)

	task.delay(PLASMA_COOLDOWN, function()
		CanShoot = true
	end)
end

