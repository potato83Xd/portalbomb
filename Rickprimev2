-- PORTAL
--------------------------------------------------

local function CreatePortal(position)

	local portal = Instance.new("Part")

	portal.Name = "Portal3D"
	portal.Shape = Enum.PartType.Cylinder
	portal.Size = Vector3.new(0.35, 6, 6)
	portal.Material = Enum.Material.Neon
	portal.Color = Color3.fromRGB(0, 255, 100)
	portal.Transparency = 0.35
	portal.Anchored = true
	portal.CanCollide = false
	portal.CanTouch = false
	portal.CanQuery = false
	portal.CastShadow = false
	portal.CFrame =
		CFrame.new(position)
		* CFrame.Angles(0, 0, math.rad(90))

	portal.Parent = workspace

	for _, face in ipairs({
		Enum.NormalId.Left,
		Enum.NormalId.Right
	}) do

		local decal = Instance.new("Decal")

		decal.Name = "PortalTexture"
		decal.Texture = PORTAL_TEXTURE
		decal.Face = face
		decal.Parent = portal
	end

	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(60, 255, 90)
	light.Brightness = 4
	light.Range = 22
	light.Parent = portal

	local sound = Instance.new("Sound")
	sound.SoundId = PORTAL_OPEN_SOUND
	sound.Volume = 1.8
	sound.RollOffMaxDistance = 80
	sound.Parent = portal
	sound:Play()

	local rotation = 0
	local connection

	connection = RunService.Heartbeat:Connect(function(dt)

		if not portal.Parent then
			connection:Disconnect()
			return
		end

		rotation += dt * 40

		portal.CFrame =
			CFrame.new(position)
			* CFrame.Angles(
				0,
				math.rad(rotation),
				math.rad(90)
			)
	end)

	sound.Ended:Connect(function()
		sound:Destroy()
	end)

	return portal
end

