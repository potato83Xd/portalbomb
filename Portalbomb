-- === ASEGURAR ASSETS (Fallback procedural si no existen en ReplicatedStorage) ===
local function getOrCreateTemplate(name, color, shape, size)
	local template = ReplicatedStorage:FindFirstChild(name)
	if not template then
		template = Instance.new("Model")
		template.Name = name
		local part = Instance.new("Part")
		part.Size = size or Vector3.new(3, 1, 3)
		part.BrickColor = BrickColor.new(color)
		part.Material = Enum.Material.Neon
		if shape == "Sphere" then
			part.Shape = Enum.PartType.Ball
		end
		part.Anchored = true
		part.CanCollide = false
		part.Parent = template
		template.PrimaryPart = part
	end
	return template
end

