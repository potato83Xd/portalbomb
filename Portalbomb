local function clean(model)
	for _, v in ipairs(model:GetDescendants()) do
		if v:IsA("BasePart") then
			v.CanCollide = false
			v.Anchored = true
			v.Massless = true
		end
	end
end

local function destroyMarker()
	if marker then
		marker:Destroy()
		marker = nil
	end
end

